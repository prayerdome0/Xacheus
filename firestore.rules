rules_version = '2';

// Xacheus — Production-oriented Firestore rules (Phase 1: video platform)
// Deploy: firebase deploy --only firestore:rules
// Principles:
// - public read for videos, users, sounds, hashtags so guests can browse
// - writes scoped to owner, counters via ±1 only where needed
// - role field cannot be escalated by client; only admin can change roles
// - never expose secrets; all protection here

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function existingUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && existingUser().role == "admin";
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    /* ---------------------------------------------------------------- */
    /* users                                                             */
    /* ---------------------------------------------------------------- */
    match /users/{uid} {
      allow read: if true;

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll(['uid','username','displayName','createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.displayName.size() <= 40
        && (!('role' in request.resource.data) || request.resource.data.role in ["user","creator","business","church"]);

      // Owners can edit profile but not role, uid, counters directly
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','displayNameLower','username','bio','location',
                       'website','photoURL','coverURL','theme','private','updatedAt']);

      // Admin can change role and verified status
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role','verified','updatedAt'])
        && request.resource.data.role in ["user","creator","business","church","admin"];

      // Counters: any signed-in user can bump by ±1 (follow, video count etc)
      // This is needed because follow bumps other user's counter.
      allow update: if signedIn()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['followersCount','followingCount','videosCount','postsCount','likesCount']);

      allow delete: if isSelf(uid) || isAdmin();

      match /likedVideos/{videoId} {
        allow read, write: if isSelf(uid);
      }
      match /savedVideos/{videoId} {
        allow read, write: if isSelf(uid);
      }
      match /favoriteSounds/{soundId} {
        allow read, write: if isSelf(uid);
      }
      // legacy liked/saved for posts
      match /liked/{postId} {
        allow read, write: if isSelf(uid);
      }
      match /reposted/{postId} {
        allow read, write: if isSelf(uid);
      }
      match /saved/{postId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /usernames/{handle} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9_]{3,20}$');
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    /* ---------------------------------------------------------------- */
    /* videos                                                            */
    /* ---------------------------------------------------------------- */
    match /videos/{videoId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.caption, 1000)
        && (
          // video post
          (request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() > 0)
          // photo post (1-6 images)
          || (request.resource.data.mediaType == 'photo'
              && request.resource.data.images is list
              && request.resource.data.images.size() >= 1
              && request.resource.data.images.size() <= 6)
        )
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.viewCount == 0;

      // Author can edit caption, hashtags, thumbnail, etc. but not counters
      allow update: if signedIn()
        && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['caption','hashtags','mentions','thumbnailUrl','soundTitle','soundId','soundUrl','isPublic','updatedAt']))
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likeCount','commentCount','viewCount','shareCount'])
        );

      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && shortText(request.resource.data.text, 500);
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/videos/$(videoId)).data.uid == request.auth.uid
              || isAdmin());
      }
    }

    /* ---------------------------------------------------------------- */
    /* sounds                                                            */
    /* ---------------------------------------------------------------- */
    match /sounds/{soundId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.artistUid == request.auth.uid
        && shortText(request.resource.data.title, 80)
        && request.resource.data.audioUrl is string
        && request.resource.data.audioUrl.size() > 0
        && request.resource.data.useCount == 0;

      // Owner or admin can edit; anyone signed in can bump counters
      allow update: if signedIn()
        && (
          (resource.data.artistUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title','coverUrl','genre','bpm','isFree','updatedAt']))
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['useCount','lastUsedAt','favoriteCount'])
          || isAdmin()
        );

      allow delete: if signedIn() && (resource.data.artistUid == request.auth.uid || isAdmin());
    }

    /* ---------------------------------------------------------------- */
    /* follows                                                           */
    /* ---------------------------------------------------------------- */
    match /follows/{uid} {
      match /following/{targetUid} {
        allow read: if true;
        allow create, delete: if isSelf(uid);
      }
      match /followers/{followerUid} {
        allow read: if true;
        allow create: if signedIn() && followerUid == request.auth.uid;
        allow delete: if signedIn() && (followerUid == request.auth.uid || isSelf(uid));
      }
    }

    /* ---------------------------------------------------------------- */
    /* notifications                                                     */
    /* ---------------------------------------------------------------- */
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.type in ['like','comment','follow','mention','repost','message','gift']
        && request.resource.data.read == false;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    /* ---------------------------------------------------------------- */
    /* hashtags + legacy posts (read)                                    */
    /* ---------------------------------------------------------------- */
    match /hashtags/{tag} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if false; // legacy, no new posts via old collection
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      match /comments/{cid} {
        allow read: if true;
        allow create, delete: if false;
      }
    }

    /* ---------------------------------------------------------------- */
    /* future: opportunities, churches, etc (admin-only write)           */
    /* ---------------------------------------------------------------- */
    match /opportunities/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /churches/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      match /sermons/{sid} {
        allow read: if true;
        allow write: if signedIn() && get(/databases/$(database)/documents/churches/$(id)).data.uid == request.auth.uid;
      }
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------------------------------------------------------------- */
    /* lives (client-only live streaming via Cloudinary segments)        */
    /* ---------------------------------------------------------------- */
    match /lives/{liveId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'live'
        && shortText(request.resource.data.title, 120)
        && request.resource.data.viewerCount == 0
        && request.resource.data.latestSeq == 0
        && request.resource.data.segmentCount == 0;

      // Broadcaster controls stream state; signed-in viewers may bump counters only.
      allow update: if signedIn()
        && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status','latestSeq','segmentCount','lastPingAt','endedAt','thumbnailUrl','title','updatedAt','pinnedChatId']))
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['viewerCount','giftCount','giftCoins','likeCount','shareCount'])
        );

      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /segments/{sid} {
        allow read: if true;
        // Only the broadcaster publishes segments.
        allow create: if signedIn()
          && request.resource.data.seq is number
          && request.resource.data.url is string
          && request.resource.data.url.size() > 0
          && get(/databases/$(database)/documents/lives/$(liveId)).data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      match /chat/{mid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        // Viewer can delete own message; stream host or admin can moderate.
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/lives/$(liveId)).data.uid == request.auth.uid
              || isAdmin());
        allow update: if false;
      }

      // Paid gifts — anyone signed in can send; immutable once written.
      match /gifts/{gid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.giftId is string
          && request.resource.data.coins is number
          && request.resource.data.coins > 0
          && request.resource.data.coins <= 10000
          && request.resource.data.emoji is string
          && request.resource.data.label is string;
        allow update, delete: if false;
      }

      // Floating reactions — high frequency, free, immutable.
      match /reactions/{rid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() <= 8;
        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------------- */
    /* conversations (direct messages)                                   */
    /* ---------------------------------------------------------------- */
    match /conversations/{cid} {
      function participantOf(data) {
        return signedIn() && request.auth.uid in data.participants;
      }
      allow read: if participantOf(resource.data);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 120;
      // Participants may update the preview + unread counters,
      // but membership is frozen once the conversation exists.
      allow update: if participantOf(resource.data)
        && request.resource.data.participants == resource.data.participants;
      // No deletes — threads and their messages are permanent.
      allow delete: if false;
      match /messages/{mid} {
        allow read: if participantOf(get(/databases/$(database)/documents/conversations/$(cid)).data);
        allow create: if participantOf(get(/databases/$(database)/documents/conversations/$(cid)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        // Messages are immutable — no edits, no deletes.
        allow update, delete: if false;
      }
    }
  }
}
