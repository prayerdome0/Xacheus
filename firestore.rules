rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'zacheussimbaya@gmail.com';
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if owns(userId) || isAdmin();
      allow read, update: if owns(userId) || isAdmin();
      allow delete: if isAdmin();

      match /blueprints/{blueprintId} {
        allow create, read, update: if owns(userId) || isAdmin();
        allow delete: if owns(userId) || isAdmin();
      }

      match /paymentConfirmations/{paymentId} {
        allow create, read: if owns(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // The store document is the source of truth for the theme editor, catalog,
      // navigation, orders, and settings belonging to one account.
      match /store/{storeId} {
        allow create, read, update, delete: if owns(userId) || isAdmin();
      }
    }

    // Published storefronts are public to read, but only the owner can publish
    // or update their copy (admins can manage them too).
    match /publicStores/{storeSlug} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() || (signedIn() && request.resource.data.publishedBy == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.publishedBy == request.auth.uid);

      match /orders/{orderId} {
        allow create: if get(/databases/$(database)/documents/publicStores/$(storeSlug)).data.published == true
          && request.resource.data.storeSlug == storeSlug
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() <= 80
          && request.resource.data.customerPhone is string
          && request.resource.data.customerPhone.size() <= 30
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= 1000000
          && request.resource.data.source == "whatsapp_manual";
        allow read, update: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/publicStores/$(storeSlug)).data.publishedBy == request.auth.uid);
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/publicStores/$(storeSlug)).data.publishedBy == request.auth.uid);
      }
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /payment_confirmations/{paymentId} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
