rules_version = '2';

// Xacheus — Firebase Storage rules.
// Deploy with: firebase deploy --only storage
//
// Layout (built by js/storage.js):
//   uploads/{uid}/{kind}/{filename}
//     kind: images | thumbnails | videos | audio | stories | documents
//
// Principles:
//   - every media object is readable, because posts, photos, stories and sound
//     covers are public content by design
//   - only the signed-in owner may write inside their own {uid} folder, and
//     only under a known kind
//   - per-kind size + content-type limits stop abuse (no 4 GB "thumbnails",
//     no HTML/SVG payloads that could execute when opened directly)
//   - deletes are owner-only, so a deleted post's file really goes away

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function mediaType() {
      return request.resource.contentType;
    }
    function isImage() {
      return mediaType().matches('image/(png|jpeg|jpg|gif|webp|avif)');
    }
    function isVideo() {
      return mediaType().matches('video/(mp4|quicktime|webm|x-m4v|3gpp)');
    }
    function isAudio() {
      return mediaType().matches('audio/(mpeg|mp3|mp4|m4a|wav|ogg|aac|x-m4a|flac)');
    }
    function isDocument() {
      return mediaType().matches('application/(pdf|json|zip|x-zip-compressed|vnd.openxmlformats-officedocument.*|msword|vnd.ms-excel|vnd.ms-powerpoint|epub\\+zip)')
        || mediaType().matches('text/(plain|csv)');
    }
    // Anything that could run in a browser when opened straight from the CDN.
    function isDangerousType() {
      return mediaType().matches('text/html|application/xhtml.*|image/svg.*|text/xml|application/xml.*|application/javascript.*');
    }

    // Public read for all uploaded media.
    match /uploads/{allPaths=**} {
      allow read: if true;
    }

    match /uploads/{uid}/{kind}/{filename} {
      function kindAllowed() {
        return kind in ['images', 'thumbnails', 'videos', 'audio', 'stories', 'documents'];
      }
      function sizeOk() {
        return request.resource.size > 0
          && (
            (kind == 'images' && request.resource.size <= 15 * 1024 * 1024)
            || (kind == 'thumbnails' && request.resource.size <= 6 * 1024 * 1024)
            || (kind == 'stories' && request.resource.size <= 40 * 1024 * 1024)
            || (kind == 'videos' && request.resource.size <= 110 * 1024 * 1024)
            || (kind == 'audio' && request.resource.size <= 40 * 1024 * 1024)
            || (kind == 'documents' && request.resource.size <= 30 * 1024 * 1024)
          );
      }
      // Nested ternary because rules functions take a single expression.
      function typeOk() {
        return isDangerousType()
          ? false
          : kind == 'images' || kind == 'thumbnails'
            ? isImage() || isVideo()                                     // cover art may be a still or a poster
            : kind == 'videos' || kind == 'stories'
              ? isVideo() || isImage()                                   // stories accept either
              : kind == 'audio'
                ? isAudio()
                : kind == 'documents'
                  ? isDocument() || isImage() || isVideo() || isAudio()   // chat attachments
                  : false;
      }
      function safeName() {
        return !filename.contains('..') && filename.size() <= 140;
      }

      allow create: if signedIn()
        && request.auth.uid == uid
        && kindAllowed()
        && safeName()
        && sizeOk()
        && typeOk();

      // A resumable upload finishes with a metadata write — same constraints.
      allow update: if signedIn()
        && request.auth.uid == uid
        && kindAllowed()
        && sizeOk()
        && typeOk();

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Everything outside the layout above is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
