# ── Seedwel Hub — Firebase Web app (public client config) ────────────────────
# Copy this file to .env and paste the official web app config from:
#   https://console.firebase.google.com → Project settings → Your apps → Web app.
# These are PUBLIC client identifiers. Firestore/Storage rules + custom claims
# are what protect access. Never put a Firebase service-account key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push / FCM public key. The private key stays in Firebase Cloud
# Messaging settings / Cloud Functions, never in the repo.
VITE_FIREBASE_VAPID_PUBLIC_KEY=

# Cloudinary — public values only. The API secret must live in Cloud Functions.
# "Preset" here means an unsigned upload preset created in the Cloudinary console.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_PRESET=

# Require users to confirm the email sent by Firebase before they continue.
VITE_REQUIRE_EMAIL_VERIFICATION=true

# Default marketplace locale. Multi-country is data-driven (see the docs).
VITE_DEFAULT_COUNTRY=ZM
VITE_DEFAULT_CURRENCY=ZMW


