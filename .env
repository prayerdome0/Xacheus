# ── Seedwel Hub — Firebase Web app (public client config) ────────────────────
# Fill these from Firebase Console → Project settings → Your apps → Web app.
# They are PUBLIC client identifiers; access control is in firebase/firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary public values (never the API secret).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_PRESET=

VITE_REQUIRE_EMAIL_VERIFICATION=true

# Default marketplace locale.
VITE_DEFAULT_COUNTRY=ZM
VITE_DEFAULT_CURRENCY=ZMW

